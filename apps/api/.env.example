# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://ecp_user:ecp_password@localhost:5433/ecp_db?schema=public"

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Password reset
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
FRONTEND_URL=http://localhost:5173

# Throttling (requests per ttl window, seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Redis (used from Week 5-6 onward for BullMQ / caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP (email integration). Leave SMTP_HOST blank to run with email sending
# disabled (EmailService logs and no-ops instead of throwing).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ECP Platform <no-reply@ecp.local>"

# Background jobs (BullMQ repeatable job schedules, standard cron syntax)
DAILY_REMINDER_CRON=0 8 * * *
WEEKLY_SUMMARY_CRON=0 8 * * 1

# File uploads (Attachments module)
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=uploads
